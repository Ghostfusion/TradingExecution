# TradingExecution environment. Copy to .env and fill in.
# All keys optional; defaults shown. Never commit .env.

# --- paths (defaults shown) ---
# Watch the TradingAgents reports tree directly (recursive discovery of
# research_decision.json, newest-per-symbol only). Default ./decisions inbox.
TRADINGEXEC_WATCH_DIR=./decisions
TRADINGEXEC_DATA_DIR=./signals
TRADINGEXEC_AUDIT_FILE=./audit/audit.jsonl
TRADINGEXEC_JOURNAL_FILE=./audit/journal.jsonl
TRADINGEXEC_MANDATE_PATH=./mandate.json
TRADINGEXEC_KILL_SWITCH_PATH=./kill_switch
TRADINGEXEC_HALT_LATCH_PATH=./audit/halt_episode.json
TRADINGEXEC_HEARTBEAT_PATH=./audit/heartbeat
TRADINGEXEC_PID_FILE=./signald.pid

# --- daemon behavior ---
TRADINGEXEC_POLL_SECONDS=10
TRADINGEXEC_INGEST_WINDOW_HOURS=24
TRADINGEXEC_COOLDOWN_HOURS=12
TRADINGEXEC_MIN_CASH_RESERVE_USD=25000
TRADINGEXEC_REF_REQUIRED=true

# --- notifier (webhook sink: Discord / Telegram / email-via-webhook) ---
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# (https://discord.com/api/webhooks/... or legacy discordapp.com). The daemon
# formats signals as content+embeds and sends a browser-like User-Agent
# (Discord's Cloudflare edge rejects default urllib agents with 403/1010).
TRADINGEXEC_NOTIFIER_URL=https://discord.com/api/webhooks/ID/TOKEN
TRADINGEXEC_NOTIFIER_TIMEOUT_S=5
TRADINGEXEC_NOTIFIER_RETRIES=2

# --- Alpaca paper (reference data + tradeability; Phase A never submits orders) ---
# Either the ALPACA_* names below OR the research repo's TRADINGAGENTS_ALPACA_*
# names (API_KEY_ID / API_SECRET) are accepted.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true