# TradingExecution environment. Copy to .env and fill in.
# All keys optional; defaults shown. Never commit .env.

# --- paths (defaults shown) ---
# Watch the TradingAgents reports tree directly (recursive discovery of
# research_decision.json, newest-per-symbol only). Default ./decisions inbox.
TRADINGEXEC_WATCH_DIR=./decisions
TRADINGEXEC_DATA_DIR=./signals
TRADINGEXEC_AUDIT_FILE=./audit/audit.jsonl
TRADINGEXEC_JOURNAL_FILE=./audit/journal.jsonl
TRADINGEXEC_MANDATE_PATH=./mandate.json
TRADINGEXEC_KILL_SWITCH_PATH=./kill_switch
TRADINGEXEC_HALT_LATCH_PATH=./audit/halt_episode.json
TRADINGEXEC_HEARTBEAT_PATH=./audit/heartbeat
TRADINGEXEC_PID_FILE=./signald.pid

# --- daemon behavior ---
TRADINGEXEC_POLL_SECONDS=10
TRADINGEXEC_INGEST_WINDOW_HOURS=24
TRADINGEXEC_COOLDOWN_HOURS=12
TRADINGEXEC_MIN_CASH_RESERVE_USD=25000
TRADINGEXEC_REF_REQUIRED=true
# TRADINGEXEC_DRY_RUN=false          # evaluate + journal only, never submit (default false)
# TRADINGEXEC_LATEST_ONLY=true       # process only the newest artifact per symbol (default true)
# TRADINGEXEC_WATCH_RECURSIVE=true   # walk the watch dir recursively for research_decision.json
#                                    # (default true; false = the flat ./decisions inbox)
# TRADINGEXEC_APPROVAL_THRESHOLD_FACTOR=1.0  # x mandate.max_notional_per_order_usd = the notional
#                                    # at or above which a manual-high-order mandate needs approval

# --- scan window (regular session only) ---
# The daemon processes artifacts only while the regular session is open - 09:30-16:00 ET,
# 13:00 on half days, no weekends or holidays - evaluated in EXCHANGE time via the shipped
# calendar, so the host's zone never enters the decision (08:30-15:00 on this US-Central
# box, year round). Each phase change is logged once; the heartbeat is touched either way,
# so a closed market never looks like a dead daemon to `signald watchdog`.
# TRADINGEXEC_SCAN_RTH_ONLY=true
# The calendar is cross-checked against the broker's own /clock, which knows about
# unscheduled halts and early closes the shipped calendar cannot; an unavailable clock
# means DO NOT SCAN (fail closed). `signald run --once` ignores the window on purpose -
# that is the operator override.
# TRADINGEXEC_SCAN_CONFIRM_BROKER_CLOCK=true

# --- notifier (webhook sink: Discord / Telegram / email-via-webhook) ---
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# (https://discord.com/api/webhooks/... or legacy discordapp.com). The daemon
# formats signals as content+embeds and sends a browser-like User-Agent
# (Discord's Cloudflare edge rejects default urllib agents with 403/1010).
TRADINGEXEC_NOTIFIER_URL=https://discord.com/api/webhooks/ID/TOKEN
TRADINGEXEC_NOTIFIER_TIMEOUT_S=5
TRADINGEXEC_NOTIFIER_RETRIES=2

# --- Alpaca paper (reference data + tradeability; Phase A never submits orders) ---
# Only the ALPACA_* / TRADINGEXEC_ALPACA_* names are read. The research repo's
# TRADINGAGENTS_ALPACA_* names are deliberately NOT accepted (design §2.2 rule 3):
# execution owns its keys, so the sibling repo's .env is never an input.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ============================================================================
# v2 keys (implementation plan §3). All optional: the values below are the
# built-in defaults. Uncomment a line to override. Every key is hashed into
# Owner decision 2026-09-13: the four switches (MODE, INTRADAY_ENABLED,
# API_ENABLED, MCP_ENABLED) default ON and are set explicitly in .env.
# config_hash except the secrets (api key id + signing secret, Alpaca keys).
# ============================================================================

# --- mode + sleeves ---
# TRADINGEXEC_MODE=paper  # signal | paper | live (default: paper); the order path
#                        # needs paper/live AND the caller's execute=True
# TRADINGEXEC_SLEEVE_SWING_CAPITAL_PCT=0.70  # hard capital ceiling, swing
# TRADINGEXEC_SLEEVE_INTRADAY_CAPITAL_PCT=0.30  # hard capital ceiling, intraday
# TRADINGEXEC_SLEEVE_SWING_VOL_TARGET=0.10  # annualized vol target, swing
# TRADINGEXEC_SLEEVE_INTRADAY_VOL_TARGET=0.10  # annualized vol target, intraday
# TRADINGEXEC_INTRADAY_RESERVE_TO_SWING=false  # idle intraday capital never auto-flows to swing

# --- risk budgets ---
# TRADINGEXEC_RISK_PER_TRADE_INTRADAY_PCT=0.0025  # of house equity
# TRADINGEXEC_RISK_PER_TRADE_SWING_PCT=0.005  # of house equity
# TRADINGEXEC_MAX_HEAT_PCT=0.03  # open risk across the book
# TRADINGEXEC_MAX_POSITIONS_INTRADAY=5
# TRADINGEXEC_MAX_POSITIONS_SWING=8  # total <=12 enforced
# TRADINGEXEC_MAX_SINGLE_NAME_PCT_SWING=0.10  # of house equity
# TRADINGEXEC_MAX_SINGLE_NAME_PCT_INTRADAY=0.05  # of house equity
# TRADINGEXEC_MAX_ADV_PCT=0.25  # of 20-day ADV, per order
# TRADINGEXEC_CLUSTER_CAP_PCT=0.25  # of sleeve notional per correlated cluster
# TRADINGEXEC_ES_BUDGET_SLEEVE_PCT=0.015  # 1-day 97.5% ES of the sleeve
# TRADINGEXEC_ES_BUDGET_HOUSE_PCT=0.010  # 1-day 97.5% ES of the book
# TRADINGEXEC_ES_CONFIDENCE=0.975
# TRADINGEXEC_ES_BACKTEST_DAYS=500
# TRADINGEXEC_DAILY_LOSS_SOFT_PCT=0.01  # halve size
# TRADINGEXEC_DAILY_LOSS_HARD_PCT=0.03  # flatten intraday
# TRADINGEXEC_DERISK_5D_PCT=0.06  # rung 3
# TRADINGEXEC_DERISK_DD_PCT=0.10  # rung 3
# TRADINGEXEC_DERISK_HALT_DD_PCT=0.15  # kill switch
# TRADINGEXEC_KELLY_FRACTION=0.25  # quarter-Kelly input, shrunk
# TRADINGEXEC_LEVERAGE_CAP=1.5
# TRADINGEXEC_VOL_HALFLIFE_DAYS=20.0  # EWMA half-life
# TRADINGEXEC_VOL_WARMUP_DAYS=270  # scaling disabled below this
# TRADINGEXEC_VOL_SCALE_CAP=1.5  # hard cap on the scalar
# TRADINGEXEC_VOL_REBALANCE_BAND=0.12  # act only beyond this relative move
# TRADINGEXEC_STRESS_CORRELATION=0.85  # cluster stress

# --- intraday sleeve ---
# TRADINGEXEC_INTRADAY_ENABLED=true  # on by default; the router also needs the caller's enabled=True
# TRADINGEXEC_INTRADAY_ENTRY_AFTER=09:35  # ET
# TRADINGEXEC_INTRADAY_ENTRY_BEFORE=11:00  # ET
# TRADINGEXEC_INTRADAY_FLAT_BY=15:50  # ET
# TRADINGEXEC_INTRADAY_MAX_TRADES_PER_NAME=1
# TRADINGEXEC_OPENING_RANGE_MINUTES=5
# TRADINGEXEC_RVOL_MIN=2.0  # first-5-min relative volume
# TRADINGEXEC_RVOL_TOP_N=20  # rank gate
# TRADINGEXEC_MIN_PRICE=5.0
# TRADINGEXEC_MIN_ADV_SHARES=1000000  # 14-day
# TRADINGEXEC_MIN_ATR=0.50  # 14-day
# TRADINGEXEC_ADX_TREND=25.0
# TRADINGEXEC_ADX_RANGE=20.0
# TRADINGEXEC_STOP_ATR_MULT=1.75
# TRADINGEXEC_STOP_MAE_PCTL=0.80  # MAE percentile floor for stop distance
# TRADINGEXEC_COST_GATE_MULTIPLE=3.0  # expected move > k x round trip
# TRADINGEXEC_COST_LIQUID_BPS=12.0  # round trip, liquid
# TRADINGEXEC_COST_LOWFLOAT_BPS=30.0  # round trip, low-float

# --- data, clock ---
# TRADINGEXEC_DATA_FEED=sip  # sip | iex
# TRADINGEXEC_MAX_QUOTE_STALENESS_S=2.0
# TRADINGEXEC_MAX_BAR_STALENESS_S=60.0
# TRADINGEXEC_CLOCK_MAX_OFFSET_MS=50.0  # FINRA 4590

# --- api ---
# TRADINGEXEC_API_ENABLED=true  # on by default; served by `signald api`
# TRADINGEXEC_API_BIND=127.0.0.1:8787  # loopback default
# TRADINGEXEC_API_KEY_ID=  # required by `signald api`; the launcher maps it to the admin role
# TRADINGEXEC_API_SIGNING_SECRET=  # secret; excluded from config_hash
# TRADINGEXEC_API_REPLAY_WINDOW_S=300.0
# TRADINGEXEC_APPROVAL_TTL_S=900.0  # single-use approval token TTL

# --- mcp ---
# TRADINGEXEC_MCP_ENABLED=true  # on by default; served by `signald mcp`
# TRADINGEXEC_MCP_BIND=127.0.0.1  # never 0.0.0.0
# TRADINGEXEC_MCP_TOOLSETS=read,simulate,propose  # mutating tools absent unless listed

# --- lineage ---
# TRADINGEXEC_TRIAL_REGISTRY=./audit/trials.jsonl  # N is a first-class output
# TRADINGEXEC_BACKUP_DIR=./backups